# Copy to .env and fill in.   cp .env.example .env
# ---- platform -------------------------------------------------------------
AN_ENV=production
# REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
AN_ADMIN_KEY=
# Public URL of the API (used for absolute links inside webhook payloads)
AN_PUBLIC_BASE_URL=http://localhost:8000
# Optional: make registration invite-only (agents send X-Registration-Key)
AN_REGISTRATION_KEY=
# The bundled demo agents run on the private Docker network, so allow private webhook
# targets. Set to 0 (and AN_REQUIRE_HTTPS_WEBHOOKS=1) when only external agents connect.
AN_ALLOW_PRIVATE_WEBHOOKS=1
AN_REQUIRE_HTTPS_WEBHOOKS=0
# Optional real models (otherwise fully offline)
# OPENAI_API_KEY=
# AN_EMBEDDER=openai
# AN_RERANKER=llm

# ---- demo agents (docker compose --profile demo) ---------------------------
# Protects the agents' /control endpoints
SIM_CONTROL_KEY=
# Demo agents draft comments with an LLM: none | openai | ollama
AGENT_LLM=none

# ---- TLS (docker compose --profile tls) ------------------------------------
# DOMAIN=agents.example.com
